# See https://www.dartlang.org/guides/libraries/private-files

# Files and directories created by pub
.dart_tool/
.packages
build/
# pubspec.lock is committed: this is an application, not a library, so
# contributors should resolve to the same dependency versions we ship.

# Directory created by dartdoc
# If you don't generate documentation locally you can remove this line.
doc/api/

# dotenv environment variables file
.env*
!.env.example

# Avoid committing generated Javascript files:
*.dart.js
*.info.json      # Produced by the --dump-info flag.
*.js             # When generated by dart2js. Don't specify *.js if your
                 # project includes source files written in JavaScript.
*.js_
*.js.deps
*.js.map

.flutter-plugins
.flutter-plugins-dependencies

# Release signing — never commit these
android/key.properties
*.jks
*.keystore

# API secrets — copy .env.example → .env and fill in values, then run build_runner
# .env* already covered above
# Generated envied file contains obfuscated secrets — also gitignored
lib/env/env.g.dart

# IDE and editor state
.idea/
*.iml

# Python caches from scripts/ and tools/
__pycache__/
*.pyc

# Local test artefacts
test_output/
